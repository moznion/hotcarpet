# config file for the tagpr in git config format
# The tagpr generates the initial configuration, which you can rewrite to suit your environment.
# CONFIGURATIONS:
#   tagpr.releaseBranch
#       Generally, it is "main." It is the branch for releases. The tagpr tracks this branch,
#       creates or updates a pull request as a release candidate, or tags when they are merged.
#
#   tagpr.versionFile
#       Versioning file containing the semantic version needed to be updated at release.
#       It will be synchronized with the "git tag".
#
#   tagpr.vPrefix
#       Flag whether or not v-prefix is added to semver when git tagging.
#
#   tagpr.postVersionCommand
#       Command to change files just after the version file has been bumped.
#       Cargo.lock also records the crate version, so it is refreshed here to keep
#       `cargo ... --locked` in CI passing on the release pull request.
#       (tagpr.command runs before the bump, so it cannot be used for this.)
#
#   tagpr.release
#       GitHub Release creation behavior after tagging [true, draft, false].
#       The binaries are uploaded to that release by .github/workflows/release.yml.
#
#   tagpr.majorLabels / tagpr.minorLabels
#       Label names on the pull request to bump the major/minor version.
#
[tagpr]
	vPrefix = true
	releaseBranch = main
	versionFile = Cargo.toml
	postVersionCommand = cargo update --workspace
	release = true
